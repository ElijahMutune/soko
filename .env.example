DATABASE_URL=postgres://postgres:postgres@localhost:5432/sokorelay
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
SMS_MODE=console
# Generate independent random secrets of at least 32 characters. Never commit real values.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
RUST_LOG=sokorelay_api=info,tower_http=info

# Development image storage. Local disk is not suitable for Railway production.
IMAGE_STORAGE_MODE=local
# Groq vision model. Free-plan limits are enforced by Groq and may change.
# Keep the key server-side; never expose it in frontend code or commit .env.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
